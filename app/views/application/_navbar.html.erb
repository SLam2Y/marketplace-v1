<header>
  <h1 class="linkH1Header"><%= link_to t('.title'), root_path %></h1>

  <nav class="navbar navbar-expand-sm bg-light navbar-light">
    <ul class="headerList">
      <% if current_user&.role == "admin" %>
        <li><%= link_to t('.admin'), admin_index_path %></li>
      <% end %>

      <li class="ms-auto">
        <% if user_signed_in? %>
          <%= current_user.email %>
          <%= link_to t('.exit'), destroy_user_session_path, data: { turbo_method: :delete } %>
        <% else %>
          <%= link_to t('.login'), new_user_session_path %>
          <%= link_to t('.signup'), new_user_registration_path %>
        <% end %>
      </li>

      <li>
        <%= link_to "RU", url_for(locale: :ru) %>
        <%= link_to "EN", url_for(locale: :en) %>
      </li>
    </ul>
  </nav>
</header>
